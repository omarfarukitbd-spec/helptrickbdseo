<!--
================================================================================
HelpTrickBD - Sitewide SolaimanLipi Typography, Bold Titles & Full Width Engine
================================================================================
Benefits:
1. Pure English comments - zero non-ASCII or Bengali characters in theme XML.
2. Single post H1 headline restored to full prominent size (28px desktop, 23px mobile).
3. "YOU MAY LIKE" related post titles under thumbnails restored to clear, readable size (15.5px).
4. Featured overlay titles on dark cards remain crisp white (#ffffff) with high contrast.
5. SolaimanLipi font applied sitewide for clean Bengali conjunct rendering.
6. Clean CDATA block prevents Blogger XML encoding errors.

Setup Instructions:
1. Go to Blogger Dashboard: https://www.blogger.com/blog/themes/1975983966532887960
2. Click the arrow next to "Customize" and select "Edit HTML".
3. Find <head> and paste this entire snippet immediately below <head>.
4. Click Save.
================================================================================
-->

<!-- [START] HelpTrickBD SolaimanLipi Global Typography & Bold Layout -->
<link href='https://fonts.maateen.me' rel='preconnect' crossorigin='anonymous'/>
<link as='font' crossorigin='anonymous' href='https://fonts.maateen.me/solaiman-lipi/solaimanlipi-normal-v1.0.woff2' rel='preload' type='font/woff2'/>
<link as='font' crossorigin='anonymous' href='https://fonts.maateen.me/solaiman-lipi/solaimanlipi-bold-v1.0.woff2' rel='preload' type='font/woff2'/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>

<style type="text/css">
/*<![CDATA[*/
  @font-face {
    font-family: 'SolaimanLipi';
    font-display: swap;
    font-style: normal;
    font-weight: 400;
    src: url('https://fonts.maateen.me/solaiman-lipi/solaimanlipi-normal-v1.0.woff2') format('woff2');
  }
  @font-face {
    font-family: 'SolaimanLipi';
    font-display: swap;
    font-style: normal;
    font-weight: 700;
    src: url('https://fonts.maateen.me/solaiman-lipi/solaimanlipi-bold-v1.0.woff2') format('woff2');
  }

  /* 1. Apply SolaimanLipi Font Family Sitewide */
  html, body, 
  .post-body, 
  .post-title, 
  .post-title a,
  h1, h2, h3, h4, h5, h6, 
  p, span, a, li, td, th, 
  input, button, select, textarea,
  .widget, .sidebar, .header-menu, .footer,
  .entry-title, .entry-content {
    font-family: 'SolaimanLipi', 'Noto Sans Bengali', Arial, sans-serif !important;
  }

  /* 2. Restore Single Post H1 Title to Full Prominent Headline Size */
  .item-post .post-inner-area h1.entry-title,
  .item-post h1.entry-title,
  h1.entry-title {
    font-size: 28px !important;
    line-height: 1.45 !important;
    font-weight: 700 !important;
    color: var(--theme-text-color, #1a1a1a) !important;
    margin-bottom: 16px !important;
  }
  @media screen and (max-width: 768px) {
    .item-post .post-inner-area h1.entry-title,
    .item-post h1.entry-title,
    h1.entry-title {
      font-size: 23px !important;
      line-height: 1.4 !important;
    }
  }

  /* 2.1. Restore Clean & Readable Titles in Related Posts (YOU MAY LIKE) Under Thumbnails */
  .related-runs .entry-title,
  .related-runs .entry-title a,
  .Super-related .entry-title,
  .Super-related .entry-title a,
  .related-box .entry-title,
  .related-box .entry-title a {
    font-size: 15.5px !important;
    line-height: 1.4 !important;
    font-weight: 700 !important;
    color: var(--theme-text-color, #1a1a1a) !important;
  }

  /* 2.2. Homepage & Category Grid Post Titles (Color inherits theme variables for flawless Light/Dark mode) */
  .post-filter .entry-title, 
  .post-filter .entry-title a,
  .raw-box .entry-title,
  .raw-box .entry-title a,
  .block-step .entry-title,
  .block-step .entry-title a {
    font-size: 17px !important;
    font-weight: 700 !important;
    line-height: 1.45 !important;
    color: var(--theme-text-color, inherit) !important;
  }

  /* Dark Mode Universal High-Contrast Post Title Fix */
  .dark .entry-title,
  .dark .entry-title a,
  .dark .post-filter .entry-title,
  .dark .post-filter .entry-title a,
  .dark .raw-box .entry-title a,
  .dark .block-step .entry-title a {
    color: #ffffff !important;
  }

  /* ==========================================================================
     HelpTrickBD Universal Dark Mode Post Contrast & Inversion Engine
     Fixes: Callouts, TOC, Summary boxes, Badges, Tables, Headings & Inline Styles
     ========================================================================== */
  .dark .post-body,
  .dark .entry-content {
    color: #cbd5e1 !important;
  }

  .dark .post-body h1,
  .dark .post-body h2,
  .dark .post-body h3,
  .dark .post-body h4,
  .dark .post-body h5,
  .dark .post-body h6 {
    color: #ffffff !important;
  }

  .dark .post-body p,
  .dark .post-body li {
    color: #cbd5e1 !important;
  }

  .dark .post-body strong,
  .dark .post-body b {
    color: #ffffff !important;
  }

  /* Automatically adapt all inline light background containers into clean dark cards */
  .dark .post-body div[style*="background"],
  .dark .post-body section[style*="background"],
  .dark .post-body .htbd-qbox,
  .dark .post-body .htbd-link-box,
  .dark .post-body .ht-meta-engagement-badge,
  .dark .post-body .ht-toc-container,
  .dark .post-body .htbd-custom-404-container {
    background: #1e293b !important;
    border-color: #334155 !important;
    color: #f1f5f9 !important;
  }

  .dark .post-body div[style*="background"] *,
  .dark .post-body .ht-meta-engagement-badge *,
  .dark .post-body .ht-toc-container * {
    color: #f1f5f9 !important;
  }

  .dark .post-body div[style*="background"] a,
  .dark .post-body .ht-toc-container a {
    color: #38bdf8 !important;
  }

  /* Tables inside posts */
  .dark .post-body table {
    background: #1e293b !important;
    border-color: #334155 !important;
  }
  .dark .post-body table th {
    background: #0f172a !important;
    color: #38bdf8 !important;
    border-color: #334155 !important;
  }
  .dark .post-body table td {
    background: #1e293b !important;
    color: #cbd5e1 !important;
    border-color: #334155 !important;
  }


  /* 3. Featured Image Overlay Titles & Metadata (Crisp White on Dark Cards) */
  .entery-category-fly,
  .entery-category-fly .entry-title,
  .entery-category-fly .entry-title a,
  .entery-category-fly .post-snip,
  .entery-category-fly .post-snip *,
  .entery-category-fly .post-author,
  .entery-category-fly .post-date,
  .block-section.item0 .entry-title,
  .block-section.item0 .entry-title a,
  .hall-section.item0 .entry-title,
  .hall-section.item0 .entry-title a,
  .featured-box.item0 .entry-title,
  .featured-box.item0 .entry-title a,
  .video-section.item0 .entry-title,
  .video-section.item0 .entry-title a,
  .modal-grid .entry-title,
  .modal-grid .entry-title a,
  .sidebar .PopularPosts .gaint h2.entry-title,
  .sidebar .PopularPosts .gaint h2.entry-title a {
    color: #ffffff !important;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9) !important;
  }

  .block-section.item0 .entry-title,
  .block-section.item0 .entry-title a,
  .hall-section.item0 .entry-title,
  .hall-section.item0 .entry-title a,
  .video-section.item0 .entry-title,
  .video-section.item0 .entry-title a,
  .featured-box.item0 .entry-title,
  .featured-box.item0 .entry-title a {
    font-size: 22px !important;
    font-weight: 700 !important;
    line-height: 1.4 !important;
  }

  .entery-category-fly .post-author,
  .entery-category-fly .post-date,
  .entery-category-fly .post-snip {
    color: rgba(255, 255, 255, 0.92) !important;
    font-size: 13px !important;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.85) !important;
  }

  /* 4. Bold and Sharp Popular Posts in Sidebar */
  .sidebar .PopularPosts .entry-title,
  .sidebar .PopularPosts .entry-title a,
  .sidebarui-posts .entry-title,
  .sidebarui-posts .entry-title a {
    font-size: 14.5px !important;
    font-weight: 700 !important;
    line-height: 1.4 !important;
  }

  /* 5. Category Badges */
  .entery-category a,
  .post-filter .entery-category a,
  .sidebar .PopularPosts .entery-category a {
    font-weight: 700 !important;
    font-size: 11.5px !important;
    letter-spacing: 0.5px;
  }
  
  /* 6. Post Body Typography, Lists & Readability */
  .post-body p,
  .entry-content p {
    font-size: 18px !important;
    line-height: 1.85 !important;
    color: #202124 !important;
    margin-bottom: 18px !important;
  }

  .post-body ol, 
  .post-body ul,
  .entry-content ol,
  .entry-content ul {
    margin: 18px 0 24px 0 !important;
    padding-left: 28px !important;
  }

  .post-body ol li, 
  .post-body ul li,
  .entry-content ol li,
  .entry-content ul li {
    font-size: 17.5px !important;
    line-height: 1.85 !important;
    color: #24292f !important;
    margin-bottom: 14px !important;
    padding-bottom: 4px !important;
  }

  /* Distinct Question & Answer spacing inside lists */
  .post-body ol li strong,
  .post-body ul li strong,
  .entry-content ol li strong,
  .entry-content ul li strong {
    display: inline-block !important;
    margin-bottom: 5px !important;
    color: #0f172a !important;
    font-size: 18px !important;
  }

  .post-body ol li em,
  .post-body ul li em,
  .entry-content ol li em,
  .entry-content ul li em {
    font-style: normal !important;
    color: #0369a1 !important;
    font-weight: 600 !important;
  }

  /* 7. Table Responsive & Mobile Overflow Protection */
  .table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 15px 0;
  }
  .post-body table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid rgba(154, 154, 154, 0.18);
    margin: 0;
  }
  @media screen and (max-width: 768px) {
    .post-body table {
      display: block;
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  /* 8. FontAwesome Font-Display Swap Override */
  @font-face {
    font-family: 'Font Awesome 6 Free';
    font-display: swap;
  }
  @font-face {
    font-family: 'Font Awesome 6 Brands';
    font-display: swap;
  }

  /* 9. Header Logo Responsive Dimensions */
  #darkroom1 {
    max-height: 42px;
    width: auto;
    object-fit: contain;
  }
  @media screen and (max-width: 768px) {
    #darkroom1 {
      max-width: 105px !important;
      height: auto !important;
    }
  }

  /* 10. Image Cumulative Layout Shift (CLS) Prevention */
  .post-body img {
    max-width: 100% !important;
    height: auto !important;
    display: block;
    margin: 12px auto;
    border-radius: 6px;
    box-sizing: border-box;
  }
  .post-body .separator, 
  .post-body .separator a {
    max-width: 100% !important;
    display: block !important;
    margin-left: auto !important;
    margin-right: auto !important;
    text-align: center !important;
  }
  .post-body figure {
    margin: 15px auto;
    max-width: 100%;
    text-align: center;
  }
  .post-body figcaption {
    font-size: 13.5px;
    color: var(--theme-text-color, #555555);
    text-align: center;
    margin-top: 6px;
    font-style: italic;
  }

  /* 11. Homepage Hero LCP Thumbnail Visibility Permanent Fix */
  .snip-thumbnail.lcp-hero-thumb,
  img.lcp-hero-thumb,
  .snip-thumbnail[loading='eager'],
  .snip-thumbnail[fetchpriority='high'],
  .post-filter.post-0 .snip-thumbnail {
    opacity: 1 !important;
    visibility: visible !important;
  }
/*]]>*/
</style>
<!-- [END] HelpTrickBD SolaimanLipi Global Typography & Bold Layout -->

<!--
================================================================================
HelpTrickBD - Google Search Central Compliant 1:1 Redirection & Custom 404 Engine
================================================================================
Benefits:
1. 100% Google Compliant: Only redirects URLs with direct 1:1 equivalent live content (Zero Soft 404s).
2. Helpful Custom 404: Genuinely deleted posts cleanly show the branded Bengali 404 page with search bar.
3. Clean Aesthetics: Hides default theme English '404 There's nothing here!' text.
4. Zero Sitewide Overhead: Executes only on 404 pages via data:view.isError.
================================================================================
-->
<b:if cond='data:view.isError'>
<style type='text/css'>
/*<![CDATA[*/
  .errorPage > h3,
  .errorPage > h4,
  .errorPage > a.homepage {
    display: none !important;
  }
  .errorPage {
    padding: 20px 10px !important;
  }
/*]]>*/
</style>
<script type='text/javascript'>
//<![CDATA[
(function() {
  // Only valid 1:1 equivalent direct post replacements (Google Search Central Compliant)
  var directRedirects = {
    "/2022/10/cloze-test-without-clues-for-jsc-ssc.html": "/2026/09/ssc-english-1st-paper-suggestion-2027.html",
    "/2024/09/class-7-english-annual-exam-guide-pdf-2024.html": "/2026/09/ssc-english-1st-paper-suggestion-2027.html",
    "/2024/09/class-8-english-annual-exam-guide-pdf-2024.html": "/2026/09/ssc-english-1st-paper-suggestion-2027.html",
    "/2024/10/class-7-english-annual-exam-sample-question-1.html": "/2026/09/ssc-english-1st-paper-suggestion-2027.html",
    "/2024/10/class-9-english-annual-exam-guide-pdf.html": "/2026/09/ssc-english-1st-paper-suggestion-2027.html",
    "/2025/01/class-9-10-english-1st-2nd-paper-guide-2025.html": "/2026/09/ssc-english-1st-paper-suggestion-2027.html",
    "/2025/01/ssc-exam-2026-short-syllabus-pdf.html": "/2026/09/ssc-english-1st-paper-suggestion-2027.html",
    "/2025/04/class-6-english-1st-paper-guide-book-2025-pdf.html": "/2026/09/ssc-english-1st-paper-suggestion-2027.html",
    "/2025/04/class-6-english-2nd-paper-guide-book-2025-pdf.html": "/2026/09/ssc-english-1st-paper-suggestion-2027.html"
  };

  var rawPath = window.location.pathname;
  var cleanPath = rawPath.replace(/\/+$/, '');
  var pathWithHtml = cleanPath.endsWith('.html') ? cleanPath : cleanPath + '.html';
  var pathWithoutHtml = cleanPath.endsWith('.html') ? cleanPath.slice(0, -5) : cleanPath;

  var decodedClean = decodeURIComponent(cleanPath);
  var decodedWithHtml = decodeURIComponent(pathWithHtml);

  var target = directRedirects[cleanPath] ||
               directRedirects[pathWithHtml] ||
               directRedirects[pathWithoutHtml] ||
               directRedirects[decodedClean] ||
               directRedirects[decodedWithHtml];

  if (target) {
    window.location.replace(target);
  }
})();
//]]>
</script>
</b:if>
<!-- [END] HelpTrickBD Smart 301 Redirection Engine -->
