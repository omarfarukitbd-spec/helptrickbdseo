<!--
================================================================================
HelpTrickBD - Sitewide SolaimanLipi Typography, Bold Titles & Full Width Engine
================================================================================
Benefits:
1. Pure English comments - zero non-ASCII or Bengali characters in theme XML.
2. Single post H1 headline restored to full prominent size (28px desktop, 23px mobile).
3. "YOU MAY LIKE" related post titles under thumbnails restored to clear, readable size (15.5px).
4. Featured overlay titles on dark cards remain crisp white (#ffffff) with high contrast.
5. SolaimanLipi font applied sitewide for clean Bengali conjunct rendering.
6. Clean CDATA block prevents Blogger XML encoding errors.

Setup Instructions:
1. Go to Blogger Dashboard: https://www.blogger.com/blog/themes/1975983966532887960
2. Click the arrow next to "Customize" and select "Edit HTML".
3. Find <head> and paste this entire snippet immediately below <head>.
4. Click Save.
================================================================================
-->

<!-- [START] HelpTrickBD SolaimanLipi Global Typography & Bold Layout -->
<link href='https://fonts.maateen.me' rel='preconnect' crossorigin='anonymous'/>
<link as='font' crossorigin='anonymous' href='https://fonts.maateen.me/solaiman-lipi/solaimanlipi-normal-v1.0.woff2' rel='preload' type='font/woff2'/>
<link as='font' crossorigin='anonymous' href='https://fonts.maateen.me/solaiman-lipi/solaimanlipi-bold-v1.0.woff2' rel='preload' type='font/woff2'/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>

<style type="text/css">
/*<![CDATA[*/
  @font-face {
    font-family: 'SolaimanLipi';
    font-display: swap;
    font-style: normal;
    font-weight: 400;
    src: url('https://fonts.maateen.me/solaiman-lipi/solaimanlipi-normal-v1.0.woff2') format('woff2');
  }
  @font-face {
    font-family: 'SolaimanLipi';
    font-display: swap;
    font-style: normal;
    font-weight: 700;
    src: url('https://fonts.maateen.me/solaiman-lipi/solaimanlipi-bold-v1.0.woff2') format('woff2');
  }

  /* 1. Apply SolaimanLipi Font Family Sitewide */
  html, body, 
  .post-body, 
  .post-title, 
  .post-title a,
  h1, h2, h3, h4, h5, h6, 
  p, span, a, li, td, th, 
  input, button, select, textarea,
  .widget, .sidebar, .header-menu, .footer,
  .entry-title, .entry-content {
    font-family: 'SolaimanLipi', 'Noto Sans Bengali', Arial, sans-serif !important;
  }

  /* 2. Restore Single Post H1 Title to Full Prominent Headline Size */
  .item-post .post-inner-area h1.entry-title,
  .item-post h1.entry-title,
  h1.entry-title {
    font-size: 28px !important;
    line-height: 1.45 !important;
    font-weight: 700 !important;
    color: var(--theme-text-color, #1a1a1a) !important;
    margin-bottom: 16px !important;
  }
  @media screen and (max-width: 768px) {
    .item-post .post-inner-area h1.entry-title,
    .item-post h1.entry-title,
    h1.entry-title {
      font-size: 23px !important;
      line-height: 1.4 !important;
    }
  }

  /* 2.1. Restore Clean & Readable Titles in Related Posts (YOU MAY LIKE) Under Thumbnails */
  .related-runs .entry-title,
  .related-runs .entry-title a,
  .Super-related .entry-title,
  .Super-related .entry-title a,
  .related-box .entry-title,
  .related-box .entry-title a {
    font-size: 15.5px !important;
    line-height: 1.4 !important;
    font-weight: 700 !important;
    color: var(--theme-text-color, #1a1a1a) !important;
  }

  /* 2.2. Homepage & Category Grid Post Titles */
  .post-filter .entry-title, 
  .post-filter .entry-title a,
  .raw-box .entry-title,
  .raw-box .entry-title a,
  .block-step .entry-title,
  .block-step .entry-title a {
    font-size: 17px !important;
    font-weight: 700 !important;
    line-height: 1.45 !important;
    color: #1a1a1a !important;
  }

  /* 3. Featured Image Overlay Titles & Metadata (Crisp White on Dark Cards) */
  .entery-category-fly,
  .entery-category-fly .entry-title,
  .entery-category-fly .entry-title a,
  .entery-category-fly .post-snip,
  .entery-category-fly .post-snip *,
  .entery-category-fly .post-author,
  .entery-category-fly .post-date,
  .hall-section.item0 .entry-title,
  .hall-section.item0 .entry-title a,
  .featured-box.item0 .entry-title,
  .featured-box.item0 .entry-title a,
  .video-section.item0 .entry-title,
  .video-section.item0 .entry-title a,
  .modal-grid .entry-title,
  .modal-grid .entry-title a,
  .sidebar .PopularPosts .gaint h2.entry-title,
  .sidebar .PopularPosts .gaint h2.entry-title a {
    color: #ffffff !important;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9) !important;
  }

  .hall-section.item0 .entry-title,
  .hall-section.item0 .entry-title a,
  .video-section.item0 .entry-title,
  .video-section.item0 .entry-title a,
  .featured-box.item0 .entry-title,
  .featured-box.item0 .entry-title a {
    font-size: 22px !important;
    font-weight: 700 !important;
    line-height: 1.4 !important;
  }

  .entery-category-fly .post-author,
  .entery-category-fly .post-date,
  .entery-category-fly .post-snip {
    color: rgba(255, 255, 255, 0.92) !important;
    font-size: 13px !important;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.85) !important;
  }

  /* 4. Bold and Sharp Popular Posts in Sidebar */
  .sidebar .PopularPosts .entry-title,
  .sidebar .PopularPosts .entry-title a,
  .sidebarui-posts .entry-title,
  .sidebarui-posts .entry-title a {
    font-size: 14.5px !important;
    font-weight: 700 !important;
    line-height: 1.4 !important;
  }

  /* 5. Category Badges */
  .entery-category a,
  .post-filter .entery-category a,
  .sidebar .PopularPosts .entery-category a {
    font-weight: 700 !important;
    font-size: 11.5px !important;
    letter-spacing: 0.5px;
  }
  
  /* 6. Post Body Typography and Readability */
  .post-body p {
    font-size: 18px !important;
    line-height: 1.85 !important;
    color: #202124 !important;
  }

  /* 7. Table Responsive & Mobile Overflow Protection */
  .table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 15px 0;
  }
  .post-body table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid rgba(154, 154, 154, 0.18);
    margin: 0;
  }
  @media screen and (max-width: 768px) {
    .post-body table {
      display: block;
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  /* 8. FontAwesome Font-Display Swap Override */
  @font-face {
    font-family: 'Font Awesome 6 Free';
    font-display: swap;
  }
  @font-face {
    font-family: 'Font Awesome 6 Brands';
    font-display: swap;
  }

  /* 9. Header Logo Responsive Dimensions */
  #darkroom1 {
    max-height: 42px;
    width: auto;
    object-fit: contain;
  }
  @media screen and (max-width: 768px) {
    #darkroom1 {
      max-width: 105px !important;
      height: auto !important;
    }
  }

  /* 10. Image Cumulative Layout Shift (CLS) Prevention */
  .post-body img {
    max-width: 100% !important;
    height: auto !important;
    display: block;
    margin: 12px auto;
    border-radius: 6px;
    box-sizing: border-box;
  }
  .post-body .separator, 
  .post-body .separator a {
    max-width: 100% !important;
    display: block !important;
    margin-left: auto !important;
    margin-right: auto !important;
    text-align: center !important;
  }
  .post-body figure {
    margin: 15px auto;
    max-width: 100%;
    text-align: center;
  }
  .post-body figcaption {
    font-size: 13.5px;
    color: var(--theme-text-color, #555555);
    text-align: center;
    margin-top: 6px;
    font-style: italic;
  }

  /* 11. Homepage Hero LCP Thumbnail Visibility Permanent Fix */
  .snip-thumbnail.lcp-hero-thumb,
  img.lcp-hero-thumb,
  .snip-thumbnail[loading='eager'],
  .snip-thumbnail[fetchpriority='high'],
  .post-filter.post-0 .snip-thumbnail {
    opacity: 1 !important;
    visibility: visible !important;
  }

  /* 12. Homepage Category Block (block1) - Move Title Below Image & 100% Full Uncropped Banner */
  .block-section .block-img {
    height: auto !important;
    min-height: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    background: var(--bg-cards, #ffffff) !important;
    border-radius: 8px !important;
    overflow: hidden !important;
    box-shadow: var(--shadow-light, 0 1px 4px rgba(0,0,0,0.06)) !important;
  }

  /* Force 16:9 container so 100% of banner is visible without zooming or cropping */
  .block-section .block-img .post-filter-link {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 16 / 9 !important;
    display: block !important;
    overflow: hidden !important;
  }

  /* Remove dark gradient overlay over the image */
  .block-section .block-img .post-filter-link:before,
  .block-section .block-img .background-layer:before {
    display: none !important;
    background: none !important;
  }

  /* Show 100% of the image without zoom */
  .block-section .block-img img.snip-thumbnail {
    position: relative !important;
    top: 0 !important;
    left: 0 !important;
    transform: none !important;
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 16 / 9 !important;
    object-fit: cover !important;
    display: block !important;
    border-radius: 8px 8px 0 0 !important;
    filter: none !important;
  }

  /* Move title, badge, author and date into the clean space below the image */
  .block-section .block-img .entery-category-fly {
    position: static !important;
    width: 100% !important;
    padding: 16px 18px 18px 18px !important;
    box-sizing: border-box !important;
    background: var(--bg-cards, #ffffff) !important;
  }

  /* Prominent Dark Title Below Image */
  .block-section.item0 .entry-title,
  .block-section.item0 .entry-title a,
  .block-section .entery-category-fly .entry-title,
  .block-section .entery-category-fly .entry-title a {
    color: var(--theme-text-color, #1a1a1a) !important;
    text-shadow: none !important;
    font-size: 19px !important;
    line-height: 1.45 !important;
    font-weight: 700 !important;
    margin: 8px 0 10px 0 !important;
    display: block !important;
  }

  .block-section.item0 .entry-title a:hover,
  .block-section .entery-category-fly .entry-title a:hover {
    color: #2563eb !important;
  }

  /* High-Contrast Category Tag Below Image */
  .block-section .entery-category-fly .post-tag {
    display: inline-block !important;
    background: #e8f0fe !important;
    color: #1a73e8 !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    padding: 3px 10px !important;
    border-radius: 4px !important;
    text-shadow: none !important;
  }

  /* Clean Metadata Below Image */
  .block-section .entery-category-fly .post-snip,
  .block-section .entery-category-fly .post-snip *,
  .block-section .entery-category-fly .post-author,
  .block-section .entery-category-fly .post-date {
    color: #64748b !important;
    text-shadow: none !important;
    font-size: 13px !important;
    font-weight: 500 !important;
  }

  .block-section .entery-category-fly .post-author-image {
    width: 24px !important;
    height: 24px !important;
    border-radius: 50% !important;
    margin-right: 6px !important;
    vertical-align: middle !important;
    display: inline-block !important;
  }

  /* Right Side List Box (block-box) - Remove ugly dashed border & clean dividers */
  .block-box.fl {
    border: none !important;
    box-shadow: var(--shadow-light, 0 1px 4px rgba(0,0,0,0.06)) !important;
    border-radius: 8px !important;
    background: var(--bg-cards, #ffffff) !important;
  }

  .block-step {
    border-bottom: 1px solid #f1f5f9 !important;
    padding: 10px 14px !important;
  }

  .block-step:last-child {
    border-bottom: none !important;
  }

  .block-step .entery-category-box .entry-title:before {
    display: none !important;
  }
/*]]>*/
</style>
<!-- [END] HelpTrickBD SolaimanLipi Global Typography & Bold Layout -->

